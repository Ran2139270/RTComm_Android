<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+：云备份和设备到设备传输均排除全部应用数据。 -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
