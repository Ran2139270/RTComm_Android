    <!--
      FCM 推送配置（不使用 google-services 插件，运行时手动初始化，见 push/FirebaseInit）。
      默认全部留空 => 推送禁用，App 仍可正常编译运行（消息走 WebSocket + 前台服务）。
      自建部署若要启用推送，填入 Firebase 项目里 Android 应用的对应值即可：
        fcm_project_id : Firebase 项目 ID（project_id）
        fcm_app_id     : Android 应用 ID（mobilesdk_app_id，形如 1:1234567890:android:abc...）
        fcm_api_key    : Web/Android API Key（current_key）
        fcm_sender_id  : 项目编号（project_number / GCM sender id）
      服务端亦需配置 FCM 服务账号（见 backend/.env.example 的 FCM_* 项）。
    -->
    <string name="fcm_project_id" translatable="false"></string>
    <string name="fcm_app_id" translatable="false"></string>
    <string name="fcm_api_key" translatable="false"></string>
    <string name="fcm_sender_id" translatable="false"></string>
</resources>
